# ── Used by the Astro/React site (client-side, must be prefixed PUBLIC_) ──

# Where the retreat enquiry form sends its answers.
#
# Normally the /exec URL of the deployed Google Apps Script in
# apps-script/enquiry-form.gs (Deploy > New deployment > Web app). Any other
# backend that accepts a JSON POST also works: Formspree, Getform, Basin, an
# n8n/Zapier/Make webhook, or your own API route.
#
# While this is empty the form falls back to opening the visitor's mail client
# with the enquiry pre-written to executive@courtsidepadel.com, so no enquiry
# is lost — but set a real endpoint before launch.
PUBLIC_ENQUIRY_ENDPOINT=

# ── NOT used by the website. Reference only — copy these manually into the ──
# ── Google Apps Script project's Script Properties (Project Settings).     ──
# ── Apps Script has no .env access; secrets live in PropertiesService.     ──
SCRIPT_SHEET_URL=
SCRIPT_BREVO_API_KEY=
SCRIPT_BREVO_SENDER_EMAIL=awatelet@cspadel.com
SCRIPT_OWNER_EMAIL=awatelet@cspadel.com
# Brevo contact list ID (Contacts > Lists in Brevo dashboard). Leave empty to skip list assignment.
SCRIPT_BREVO_LIST_ID=
