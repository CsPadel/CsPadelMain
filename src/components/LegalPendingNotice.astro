---
/**
 * Marks a clause that was ported from the Menorca microsite and is scoped to
 * that one retreat, so it cannot stand unchanged on a multi-destination site.
 *
 * Deliberately loud: these pages must not reach production until Alexi and
 * Oliver have replaced the marked clauses with wording their legal adviser has
 * approved. Nobody on the delivery side should be able to miss it.
 */
interface Props {
  readonly reason: string;
}

const { reason } = Astro.props;
---

<div class="my-6 rounded border-2 border-dashed border-red-500/60 bg-red-50 px-5 py-4 text-sm text-red-900">
  <p class="font-semibold uppercase tracking-[0.2em] text-xs mb-2">Pending founder / legal review</p>
  <p>{reason}</p>
  <slot />
</div>
