---
import Layout from '../../layouts/Layout.astro';
import FooterIsland from '../FooterIsland';
import type { Locale } from '../../i18n/locales';
import { getPageSeo, getAlternateUrls } from '../../i18n/seo';
import { SITE_URL } from '../../constants/site';
import { getTranslations } from '../../i18n/getTranslations';
import { ENQUIRY_EMAIL } from '../../constants/forms';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seo = getPageSeo('executiveRetreat', locale);
const siteURL = Astro.site ?? new URL(SITE_URL);
const alternateUrls = getAlternateUrls(siteURL.href, 'executiveRetreat');
const c = getTranslations(locale).executivePage;
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  lang={locale}
  locale={locale}
  canonical={alternateUrls[locale]}
  alternateUrls={alternateUrls}
>
  <main class="w-full bg-white flex flex-col relative">

    {/* ── Hero (no eyebrow, no button) ── */}
    <section class="relative w-full min-h-screen flex items-end pb-24 md:pb-32 px-8 md:px-16 overflow-hidden bg-brand-dark">
      <img
        src="/imagenes/cms/corporate-hero.png"
        alt={c.heroAlt}
        class="absolute inset-0 w-full h-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(to bottom, rgba(1,25,44,0.15) 0%, rgba(1,25,44,0.45) 50%, rgba(1,25,44,0.98) 100%);"
      />
      <div class="relative z-10 max-w-7xl mx-auto w-full">
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-light text-white leading-none mb-6"
          style="font-family: var(--font-display); font-style: italic;"
        >
          {c.heroTitle}
        </h1>
        <p class="text-white/55 text-lg md:text-xl font-light max-w-xl leading-relaxed">
          {c.heroSubtitle}
        </p>
      </div>
    </section>

    {/* ── Why Padel ── */}
    <section class="py-24 md:py-32 px-8 md:px-16 bg-brand-dark">
      <div class="max-w-4xl mx-auto text-center cs-fadein">
        <blockquote
          class="text-3xl md:text-4xl lg:text-5xl font-light text-white leading-tight"
          style="font-family: var(--font-display); font-style: italic;"
        >
          &ldquo;{c.quote}&rdquo;
        </blockquote>
      </div>
    </section>

    {/* ── The Format ── */}
    <section class="py-24 md:py-32 px-8 md:px-16 bg-white">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 items-center">
        <div class="cs-fadein">
          <div class="flex items-center gap-4 mb-6">
            <span class="block h-px w-7 bg-brand-gold/40" aria-hidden="true" />
            <p class="text-[9px] uppercase tracking-[0.38em] text-brand-gold font-semibold">
              {c.formatEyebrow}
            </p>
          </div>
          <h2
            class="text-4xl md:text-5xl font-light text-brand-dark leading-tight mb-8"
            style="font-family: var(--font-display); font-style: italic;"
            set:html={c.formatTitle}
          />
          <p class="text-brand-dark/55 text-lg font-light leading-relaxed">
            {c.formatText}
          </p>
        </div>
        <div class="cs-fadein relative rounded-card overflow-hidden aspect-[4/3]">
          <img
            src="/imagenes/cms/corporate-format-empty-court.jpg"
            alt={c.formatImageAlt}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    {/* ── Three pillars ── */}
    <section class="py-24 md:py-32 px-8 md:px-16 bg-brand-ivory">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
          {c.pillars.map((pillar) => (
            <div class="group cs-fadein">
              <p class="text-[10px] uppercase tracking-[0.3em] text-brand-gold font-semibold mb-4">{pillar.number}</p>
              <h3
                class="text-xl md:text-2xl font-light text-brand-dark mb-4 leading-snug"
                style="font-family: var(--font-display); font-style: italic;"
              >
                {pillar.title}
              </h3>
              <div class="h-px w-8 bg-brand-gold/30 mb-4" />
              <p class="text-brand-dark/55 font-light leading-relaxed">{pillar.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── CTA ── */}
    <section class="py-24 md:py-32 px-8 md:px-16 bg-white">
      <div class="max-w-3xl mx-auto text-center cs-fadein">
        <div class="flex items-center justify-center gap-4 mb-5">
          <span class="block h-px w-7 bg-brand-gold/40" aria-hidden="true" />
          <p class="text-[9px] uppercase tracking-[0.38em] text-brand-gold font-semibold">
            {c.ctaEyebrow}
          </p>
          <span class="block h-px w-7 bg-brand-gold/40" aria-hidden="true" />
        </div>
        <h2
          class="text-4xl md:text-5xl font-light text-brand-dark mb-6"
          style="font-family: var(--font-display); font-style: italic;"
          set:html={c.ctaTitle}
        />
        <p class="text-brand-dark/50 text-lg font-light leading-relaxed mb-10 max-w-xl mx-auto">
          {c.ctaText}
        </p>
        <a
          href={`mailto:${ENQUIRY_EMAIL}`}
          class="btn-luxury inline-flex items-center gap-3"
        >
          {c.ctaBtn}
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </section>

    <FooterIsland client:visible locale={locale} />
  </main>
</Layout>

<style is:global>
  .cs-placeholder {
    background: linear-gradient(135deg, #041E36 0%, #01192C 100%);
  }
  .cs-fadein {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-fadein.cs-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('cs-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '-40px' }
  );

  document.querySelectorAll('.cs-fadein').forEach((el) => observer.observe(el));
</script>
