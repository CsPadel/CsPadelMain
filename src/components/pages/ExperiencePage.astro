---
import Layout from '../../layouts/Layout.astro';
import ExperienceView from '../ExperienceView';
import FooterIsland from '../FooterIsland';
import type { Locale } from '../../i18n/locales';
import { getPageSeo, getAlternateUrls } from '../../i18n/seo';
import { SITE_URL } from '../../constants/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seo = getPageSeo('experience', locale);
const siteURL = Astro.site ?? new URL(SITE_URL);
const alternateUrls = getAlternateUrls(siteURL.href, 'experience');
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  lang={locale}
  locale={locale}
  canonical={alternateUrls[locale]}
  alternateUrls={alternateUrls}
>
  <main class="w-full bg-white flex flex-col relative">
    <ExperienceView client:load locale={locale} />
    <FooterIsland client:visible locale={locale} />
  </main>
</Layout>
